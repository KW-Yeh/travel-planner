{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-planner",
      "database_id": "5cdbd68a-a979-4594-a8e2-c37ae609e5f9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "travel-planner-attachments"
    }
  ],
  "vars": {
    // Hours to cache Google route results in D1. 0 = off: Google's policies list place IDs
    // and coordinates (30 days) as cacheable, but not route results.
    "ROUTE_CACHE_TTL_HOURS": "0",
    "NAVITIME_CACHE_TTL_DAYS": "30"
  },
  "observability": {
    "enabled": true
  }
}
